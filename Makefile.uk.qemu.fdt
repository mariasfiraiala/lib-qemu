LIBQEMU_FDT_HDRS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt.h
LIBQEMU_FDT_HDRS-y += $(LIBQEMU)/subprojects/dtc/libfdt/libfdt.h
LIBQEMU_FDT_HDRS-y += $(LIBQEMU)/subprojects/dtc/libfdt/libfdt_env.h
LIBQEMU_FDT_HDRS-y += $(LIBQEMU)/subprojects/dtc/libfdt/libfdt_internal.h

LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_addresses.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_check.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_empty_tree.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_overlay.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_ro.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_rw.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_strerror.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_sw.c
LIBQEMU_FDT_SRCS-y += $(LIBQEMU)/subprojects/dtc/libfdt/fdt_wip.c

LIBQEMU_FDT_INCLUDES-y += -I$(LIBQEMU_BUILD)/include/fdt/subprojects

$(eval $(call _libqemu_import_lib,fdt,$(LIBQEMU_FDT_HDRS-y),$(LIBQEMU_FDT_SRCS-y)))
